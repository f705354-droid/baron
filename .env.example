# GEMINI_API_KEY: Required for server-side Gemini AI Copilot calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BARON_SESSION_SECRET: HMAC-SHA256 secret used for signing session tokens.
BARON_SESSION_SECRET="replace-with-strong-32-byte-secret-in-production"

# BARON_DB_PATH: Optional path to persistent JSON database file.
BARON_DB_PATH="./data/baron-nexus-db.json"

# MISP_BASE_URL & MISP_API_KEY: Optional external MISP Threat Intel instance.
MISP_BASE_URL=""
MISP_API_KEY=""

